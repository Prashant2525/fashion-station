# Core runtime
NODE_ENV=development
API_PORT=4000
API_PREFIX=v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Canonical PostgreSQL database
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:5432/POSTGRES_DATABASE?schema=public

# Client-facing API endpoints (public by design; never put secrets in these values)
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/v1

# Future integrations — leave unset until the corresponding capability is implemented.
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
SMS_PROVIDER=
SMS_SENDER_ID=
SMS_API_KEY=
OTP_SIGNING_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
CONNECTIPS_MERCHANT_ID=
CONNECTIPS_USERNAME=
CONNECTIPS_PASSWORD=
AI_RECOMMENDATION_PROVIDER=
AI_RECOMMENDATION_API_KEY=
MONITORING_DSN=
MONITORING_ENVIRONMENT=
